{
  "name": "@rem2/plugin-config-json",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "从 JSON 文件加载配置（证明配置来源是插件）",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node20 --external:node:* --outfile=dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
