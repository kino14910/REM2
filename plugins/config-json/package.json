{
  "name": "@rem2/plugin-config-json",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Loads config from a JSON file (proves config sources are plugins)",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node20 --external:node:* --outfile=dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
