{
  "name": "@rem2/plugin-logger-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Streams kernel logs to the console (proves observability is a plugin)",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node20 --external:node:* --outfile=dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
