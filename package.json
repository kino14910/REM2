{
  "name": "rem2-kernel",
  "productName": "rem2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "rem2 —— 最小内核 + 一切皆插件（Kernel + Everything-as-Plugin）的独立实现",
  "keywords": [
    "plugin",
    "kernel",
    "plugin-system",
    "di",
    "lifecycle"
  ],
  "license": "MIT",
  "author": {
    "name": "rem2-team"
  },
  "main": ".vite/build/main.cjs",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "exports": {
    ".": "./src/kernel/index.ts",
    "./package.json": "./package.json"
  },
  "imports": {
    "rem2-kernel": "./src/kernel/index.ts"
  },
  "scripts": {
    "dev": "tsx src/runtime/bootstrap/run.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:shell": "tsc -p tsconfig.shell.json --noEmit",
    "typecheck:all": "pnpm run typecheck && pnpm run typecheck:shell",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "cli": "tsx src/cli/cli.ts",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "electron": "44.5.1",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.86.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^3.0.0"
  }
}
