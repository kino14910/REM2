{
  "name": "rem2-kernel",
  "productName": "rem2-kernel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "rem2-kernel — an independent implementation of a minimal kernel + everything-as-plugin (Kernel + Everything-as-Plugin)",
  "keywords": [
    "plugin",
    "kernel",
    "plugin-system",
    "di",
    "lifecycle"
  ],
  "license": "MIT",
  "author": {
    "name": "rem2-team"
  },
  "main": ".vite/build/main.mjs",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9"
  },
  "exports": {
    ".": {
      "types": "./dist/kernel/index.d.ts",
      "default": "./dist/kernel/index.js"
    },
    "./src": "./src/kernel/index.ts",
    "./package.json": "./package.json"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "tsx src/host/cli/run.ts",
    "build": "pnpm build:kernel && pnpm build:plugins && pnpm build:external",
    "build:kernel": "tsc -p tsconfig.build.json",
    "build:plugins": "node scripts/build-plugins.mjs",
    "build:external": "node scripts/build-plugins.mjs --external",
    "build:renderer": "vite build --config vite.renderer.config.mts",
    "predev": "pnpm build",
    "premake": "pnpm build",
    "test": "vitest",
    "test:run": "vitest run --project=node",
    "test:watch": "vitest --project=node",
    "test:coverage": "vitest run --project=node --coverage",
    "test:browser": "vitest run --project=browser",
    "test:browser:watch": "vitest --project=browser",
    "test:all": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "typecheck:frontend": "tsc --noEmit -p src/frontend/tsconfig.json",
    "typecheck:browser": "tsc --noEmit -p tests/browser/tsconfig.json",
    "typecheck:shell": "tsc --noEmit -p tsconfig.shell.json",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:electron && pnpm typecheck:frontend && pnpm typecheck:browser",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "verify:render": "electron scripts/verify-render.cjs",
    "cli": "tsx src/host/cli/cli.ts",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "1.66.0",
    "@skeletonlabs/skeleton": "^5.0.1",
    "@skeletonlabs/skeleton-svelte": "5.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.0.0",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "bits-ui": "^2.20.2",
    "electron": "44.5.1",
    "electron-store": "^12.0.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.86.0",
    "playwright": "^1.64.1",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "4.1.12",
    "vitest-browser-svelte": "^3.1.0"
  }
}
