{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false,
    "noEmit": true,
    "allowJs": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "rem2-kernel": ["src/kernel/index.ts"]
    }
  },
  "include": [
    "src/kernel/**/*.ts",
    "src/shared/**/*.ts",
    "src/host/cli/**/*.ts",
    "src/host/ipc/**/*.ts",
    "src/host/plugins/**/*.ts",
    "src/host/settings/**/*.ts",
    "plugins/*/src/**/*.ts",
    "tests/**/*.ts",
    "*.ts",
    "*.mts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    ".vite",
    "plugins-dist",
    "src/host/electron/**",
    "src/main.ts",
    "src/preload.ts"
  ]
}
