{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },
  "ignorePatterns": ["dist/**", "coverage/**", ".vite/**", "node_modules/**"],
  "rules": {
    "no-console": "off",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["__rem2Probe", "__dirname"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/kernel/isolation/**"],
      "rules": {
        "unicorn/require-post-message-target-origin": "off"
      }
    }
  ]
}
